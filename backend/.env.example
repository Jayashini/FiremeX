# Copy this file to .env and fill in the values.
#   cp .env.example .env
# The real .env is git-ignored; this example is committed so the team knows
# which settings exist.

# --- Home Assistant -------------------------------------------------------
# Address of your Home Assistant instance and a long-lived access token
# (HA profile page -> Security -> Long-lived access tokens -> Create token).
HA_URL=http://localhost:8123
HA_TOKEN=paste-your-long-lived-token-here

# --- Security -------------------------------------------------------------
# Key used to sign login tokens. Leave this blank outside development:
# FiremeX then generates a unique key per installation and saves it in
# FIREMEX_DATA_DIR/.firemex_secret.
JWT_SECRET=change-me-in-development-only

# --- Database -------------------------------------------------------------
# Either set the whole connection string...
# DATABASE_DSN=host=localhost user=admin password=secretpassword dbname=firemex port=5433 sslmode=disable
# ...or set the pieces (these defaults match docker-compose.yml):
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=secretpassword
DB_NAME=firemex
DB_SSLMODE=disable

# --- Server ---------------------------------------------------------------
# Port the API listens on.
PORT=8080
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173
# Folder for files FiremeX must keep between restarts (the generated secret).
FIREMEX_DATA_DIR=.

# --- Camera feed ----------------------------------------------------------
# How long one camera frame is reused before fetching a fresh one, in
# milliseconds. This is the ceiling on the dashboard's frame rate: 200ms means
# at most 5 frames per second per camera, however many people are watching.
# Raise it to reduce load on Home Assistant, lower it for smoother video.
SNAPSHOT_TTL_MS=200

# --- Detector (one backend instance owns the worker) -----------------------
DETECTION_ENABLED=true
MODEL_URL=http://127.0.0.1:8100
DETECTION_INTERVAL_MS=2000
MODEL_TIMEOUT_MS=15000
FIRE_CONFIDENCE_THRESHOLD=0.50
SMOKE_CONFIDENCE_THRESHOLD=0.50
INCIDENT_COOLDOWN_SECONDS=60
EVIDENCE_RETENTION_DAYS=7
# 1 GiB demo budget. Confirm before unattended monitoring.
EVIDENCE_MAX_BYTES=1073741824
